# derp-admit settings. Copy to .env and fill in the secrets.
# Precedence: process env > .env (ENV_FILE) > config.yaml (CONFIG_FILE) > built-in default.
# Values shown are the built-in defaults. Every uncommented line here
# overrides config.yaml; delete lines you want config.yaml to control.

# --- Files (read from the process environment only, not from this file) ---
# CONFIG_FILE=config/config.yaml
# ENV_FILE=.env

# --- Server ---
ADDR=:8080
LOG_LEVEL=info

# --- Secrets (required unless noted; never commit real values) ---
# Postgres connection string, e.g. postgres://user:pass@host:5432/db?sslmode=disable
DATABASE_URL=
# Pepper mixed into stored token hashes.
TOKEN_PEPPER=
# Optional. Enables /admin and is the bootstrap key; at least 16 characters.
ADMIN_API_KEY=

# --- Database ---
DB_TIMEOUT=2s

# --- Policy ---
# How often each instance polls the stored policy version.
POLICY_SYNC_INTERVAL=2s

# --- Verify (/verify) ---
VERIFY_RATE_LIMIT_RPS=100
VERIFY_RATE_LIMIT_BURST=200
# 0s disables the verify decision cache.
VERIFY_CACHE_TTL=0s

# --- Register (/register) ---
REGISTER_RATE_LIMIT_RPS=5
REGISTER_RATE_LIMIT_BURST=10

# --- Admin (/admin) ---
# Rate limit per client IP, applied before authentication.
ADMIN_RATE_LIMIT_RPS=10
ADMIN_RATE_LIMIT_BURST=20

# --- Metrics ---
# Serves GET /metrics on the main listener.
METRICS_ENABLED=true

# --- OpenTelemetry tracing ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=derp-admit
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACE_SAMPLE_RATIO=1.0
