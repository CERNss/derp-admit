# Environment for deploy/docker-compose.yml.
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
#
# Lines marked REQUIRED have no default: compose refuses to start without them.
# Generate each secret with:   openssl rand -hex 32
# (hex keeps POSTGRES_PASSWORD safe inside DATABASE_URL, which is assembled as
# a plain string). The three secrets are left empty on purpose, so compose
# refuses to start until you fill them in.

# --- Secrets (REQUIRED) -------------------------------------------------------

# PostgreSQL password for the verifier's database user.
POSTGRES_PASSWORD=
# Mixed into enroll-token and admin-key hashes. Changing it invalidates every
# enroll token and every named admin key.
TOKEN_PEPPER=
# Bootstrap admin key (>= 16 characters). Also keeps /admin mounted. Create a
# named admin key with it, then revoke "bootstrap" (docs/onboarding.md).
ADMIN_API_KEY=

# --- Relay (REQUIRED: DERP_HOSTNAME) -------------------------------------------

# Public DNS name of this relay. Must match the DERP map HostName and the
# certificate.
DERP_HOSTNAME=derp.example.com
# letsencrypt (default): derper gets a certificate itself; needs DERP_HOSTNAME
#   to resolve to this host and public 443/tcp and 80/tcp.
# manual: you provide the certificate (see DERP_MANUAL_CERT_DIR).
DERP_CERTMODE=letsencrypt
# manual mode only: ABSOLUTE host directory with <DERP_HOSTNAME>.crt (full
# chain) and <DERP_HOSTNAME>.key, readable by the container user. Leave
# commented in letsencrypt mode.
#DERP_MANUAL_CERT_DIR=/etc/derp-admit/certs
# Relay name derper asks the verifier about (/verify/<relay>). It must exist in
# the verifier (built-in "default", or one created with POST /admin/relays).
DERP_RELAY=default
# "true" makes derper log every admitted and removed client.
DERP_DEBUG_LOGS=false

# --- Host ports ----------------------------------------------------------------

# Published on all host interfaces. The DERP map's DERPPort and STUNPort must
# be the values set here. Keep 443 and 80 in production: Let's Encrypt needs
# them, and the DERP map has no setting for a different HTTP port. Other
# values are for testing on a host where these ports are taken.
DERP_HTTPS_PORT=443
DERP_HTTP_PORT=80
DERP_STUN_PORT=3478
# Verifier, published on 127.0.0.1 only (admin API, operator-run enrollment).
VERIFIER_HOST_PORT=8080

# --- Network -------------------------------------------------------------------

# "front" network (derper and verifier; the published ports). Change all three
# together if the subnet collides with something on this host; DERPER_IPV4
# must be inside it. PostgreSQL is on a separate internal "backend" network
# (verifier and postgres only) whose subnet Docker picks; nothing names it.
DERP_ADMIT_SUBNET=10.203.117.0/24
DERP_ADMIT_GATEWAY=10.203.117.1
# Fixed derper address; VERIFY_ALLOWED_CIDRS is set to <DERPER_IPV4>/32.
DERPER_IPV4=10.203.117.10

# --- Verifier ------------------------------------------------------------------

LOG_LEVEL=info
# Who may read GET /metrics (comma-separated CIDRs or IPs). Default: the
# container's own loopback and the front gateway (processes on this host via
# the loopback-published port). Add your Prometheus address here.
#METRICS_ALLOWED_CIDRS=127.0.0.1/32,10.203.117.1/32
# Days of audit rows to keep; 0 keeps them forever.
VERIFY_AUDIT_RETENTION_DAYS=90
ADMIN_AUDIT_RETENTION_DAYS=365

# --- Database --------------------------------------------------------------------

POSTGRES_USER=verifier
POSTGRES_DB=verifier

# --- Images --------------------------------------------------------------------

# Verifier image; "docker compose build" builds it from this checkout and
# tags it with this name.
VERIFIER_IMAGE=ghcr.io/cernss/derp-admit:latest
# derper image built from builder/derp_admit/derper.Dockerfile.
DERPER_IMAGE=derp-admit-derper:v1.84.3
POSTGRES_IMAGE=postgres:16
